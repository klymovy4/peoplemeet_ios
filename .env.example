# Backend API URL. Variables prefixed with EXPO_PUBLIC_ are available in client code.
# Copy this file to .env and change the value if needed.
EXPO_PUBLIC_API_URL=https://peoplemeet.com.ua

# Google Maps SDK for Android key (without it the map is blank in Android builds).
# For EAS cloud builds: eas env:create --name GOOGLE_MAPS_API_KEY --value <key>
GOOGLE_MAPS_API_KEY=
